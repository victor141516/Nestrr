# Required. TMDB API Read Access Token (not the v3 API key).
TMDB_TOKEN=
# Optional. Configure either or both to enable Rotten Tomatoes ratings.
MDBLIST_API_KEY=
OMDB_API_KEY=
# Required. Generate with: openssl rand -base64 48
NESTRR_JWT_SECRET=

NESTRR_PUBLIC_ORIGIN=http://localhost:8080
PLARR_PUBLIC_ORIGIN=http://localhost:8090
# Optional. Set the same random value in Nestrr and Plarr to require
# file-scoped, expiring playback grants.
PLARR_API_KEY=
TMDB_CACHE_TTL=1h
# Optional. Defaults next to the Nestrr database.
NESTRR_KEYWORD_CACHE_PATH=
PLARR_CACHE_LIMIT=10GB
PLARR_HARDWARE_ACCELERATION=auto
PLARR_CPU_LIMIT=4.0
FLARESOLVERR_LOG_LEVEL=info
STRASTORR_POLL_INTERVAL=2
STRASTORR_LOG_LEVEL=INFO

# Filled after Jackett's first start; shown in its Web UI and ServerConfig.json.
JACKETT_API_KEY=
# qBittorrent prints a temporary password on first start. Change it, then set it here.
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
QBITTORRENT_SHOW_CATEGORY=Shows
QBITTORRENT_MOVIE_CATEGORY=Movies

TZ=Europe/Madrid
PUID=1000
PGID=1000
