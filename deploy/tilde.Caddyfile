# Insert inside Tilde's existing (services) snippet. Its wildcard listener
# already owns TLS and DNS validation for *.viti.site.
@nestrr host nestrr.viti.site
handle @nestrr {
	reverse_proxy nestrr:8080
}

@plarr host plarr.viti.site
handle @plarr {
	forward_auth nestrr:8080 {
		uri /api/v1/auth/media-check
		header_up -Origin
	}
	reverse_proxy plarr:8090 {
		flush_interval -1
	}
}
